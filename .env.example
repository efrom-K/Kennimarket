# --- LM Studio (локальная модель) ---
# В LM Studio: вкладка "Local Server" -> Start Server. По умолчанию слушает 1234.
LM_STUDIO_BASE_URL=http://localhost:1234/v1
# Имя модели как оно показано в LM Studio (или "local-model" - многие сборки игнорируют это поле)
LM_STUDIO_MODEL=deepseek/deepseek-r1-0528-qwen3-8b

# --- Telegram (для сбора реальных buy-intent сигналов из публичных каналов) ---
# Получить на https://my.telegram.org -> API development tools (1 минута, нужен номер телефона)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=leadgen_session

# --- 2GIS Catalog API (для сбора компаний-таргетов: склад/логистика/опт в Москве и МО) ---
# Получить ключ: https://dev.2gis.ru/ (регистрация, free tier)
DGIS_API_KEY=

# --- Общие настройки ---
TARGET_LEADS=1000
DB_PATH=leadgen.db
